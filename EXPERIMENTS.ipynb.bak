    "\n",
    "\n",
    "# \\#\\# I merge last 2 commits into single commit:\n",
    "\n",
    "git reset --sort HEAD~2 \\# delete last 2 commits but keep changes\n",
    "git commit --amend -m \"fix error\"\n",
